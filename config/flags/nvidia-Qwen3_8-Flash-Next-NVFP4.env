# per-model envs for the flash-next NVFP4 profile (sourced by
# spark-vllm-podman-start-select before launch; independent of other models).
# Skip Triton autotuner benchmarking (pick first valid config): eliminates the
# FlashInfer/Triton autotune hang this model hits on GB10 (see discussions).
VLLM_TRITON_FORCE_FIRST_CONFIG=1
