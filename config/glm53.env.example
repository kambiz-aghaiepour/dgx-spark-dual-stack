# GLM-5.3-Flash profile for this pair (copy to <GLM_DIR>/scripts/local.sh -- setup-glm-recipe.sh does it).
# The recipe reads this file; nothing here is a secret (the gated token lives in ~/.config/spark/glm53.env).

# The second Spark, and the CX7 address its rank binds to.
WORKER=kambiz@gx10-02
FABRIC_PEER=192.168.177.12

# Rootful podman, so the ranks can join tensorfold.slice (MemorySwapMax=0 on a ~103 GiB process) and the worker can
# mount the read-only weights. Docker stays the recipe's default; this is the opt-in.
CONTAINER_RT=podman
CONTAINER_RT_SUDO=1
CGROUP_PARENT=tensorfold.slice

# One port for every TensorFold-family stack: the switcher serialises them.
PORT=8000

# The gated abliterated checkpoint (Mia-AiLab/GLM-5.3-Flash-EXL3-4bpw-TensorFold-Ablit).
ABLIT=1

# Weights on each node's own NVMe, not over NFS: GLM is the stack that runs, and its files archive as one unit.
HF_CACHE=/srv/mia/glm53
WORKER_HF_CACHE=/srv/mia/glm53
WORKER_WEIGHTS=copy
