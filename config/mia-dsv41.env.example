# MiaAI-Lab DeepSeek-V4.1-Flash-1017 recipe settings for this pair.
# setup-mia-recipe.sh installs this as ~/mia-dsv41/scripts/local.sh.
# Running data lives on the internal NVMe; /archive (USB) is archive-only.
WORKER=kambiz@gx10-02
HF_CACHE=/srv/mia/hf
WORKER_ENGRAM_DIR=/srv/mia/engram
WORKER_CACHE_DIR=/srv/mia/rank-cache
# Container runtime: the pair runs rootful podman (the recipe's scripts/runtime.sh; PR #113).
# tensorfold.slice is the host tuning's slice: MemorySwapMax=0, so a rank cannot swap.
CONTAINER_RT=podman
CONTAINER_RT_SUDO=1
CGROUP_PARENT=tensorfold.slice
PORT=8000
HOST=0.0.0.0
CONTEXT=1048576
SPILL_GIB=0
API_KEY=0
