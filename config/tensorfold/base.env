# Base profile: DeepSeek-V4.1-Flash-1017, EXL3 2.9 bpw (LibertAI pack), TensorFold engine, 1M context.
# This is the recipe as published upstream; use it to check the stack before trying the uncensored pack.
IMAGE=tensorfold-dsv41:07aa02585f64
TF_REPO=https://github.com/Elevatormusic/TensorFold.git
TF_COMMIT=07aa02585f64
TF_DS_PREFILL_CHUNK=2048

MODEL_VIEW=${MODEL_ROOT:?}/deepseek-v41-1017-exl3-2.9bpw
DOWNLOAD_DIR=${MODEL_VIEW}.src
CACHE_DIR=${CACHE_ROOT:?}/base

SERVED_NAME=DeepSeek-V4.1-Flash-1017
SERVED_ALIAS=
PORT=8888
BIND_HOST=127.0.0.1
API_KEY_FILE=
CONTEXT=1048576
PARALLEL=4
MTP_DRAFTS=5
SPILL_GIB=64
MEM_FLOOR_GIB=1.5
TEMPERATURE=1.0
TOP_P=1.0
VISION=1
RESTART_POLICY=no
