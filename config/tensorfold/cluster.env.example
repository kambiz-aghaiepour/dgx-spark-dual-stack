# Cluster settings for the TensorFold stack. Copy to ~/.config/spark-vllm/tensorfold/cluster.env and edit.
# Read by scripts/tensorfold-engine.sh and scripts/tensorfold-model.sh; the model profiles are appended to it.

# --- The two nodes on the ConnectX-7 link (QSFP cable) ---
HEAD_IP=192.168.177.11          # head's address on the CX7 link (rank 0, rendezvous host)
WORKER_IP=192.168.177.12        # worker's address on the CX7 link (rank 1)
WORKER_SSH=kambiz@gx10-02       # how the head reaches the worker (user@host or an ssh alias)

# --- RoCE and NCCL (ibdev2netdev, ip -br addr, show_gids) ---
RDMA_DEVICES=rocep1s0f1,roceP2p1s0f1
NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1
NCCL_SOCKET_IFNAME=enp1s0f1np1   # the netdev that holds HEAD_IP / WORKER_IP
GID_INDEX=3                     # RoCE v2 IPv4 GID; -1 = auto (after a link flap the index can move)

# --- Container runtime: this fork runs the recipe under podman ---
CONTAINER_RT=podman
CONTAINER_RT_SUDO=1             # rootful: the recipe needs tensorfold.slice, /dev/infiniband and memlock
GPU_ARGS="--gpus all"           # podman 6.x; older podman: --device nvidia.com/gpu=all
CGROUP_PARENT=tensorfold.slice  # the no-swap slice from the recipe's scripts/host_tuning.sh

# --- Where the weights and the rank caches live (same paths on both nodes, internal NVMe) ---
MODEL_ROOT=$HOME/models
CACHE_ROOT=$HOME/tfv41-cache
