# dealignai DeepSeek-V4.1-Flash-1017 EXL3 2.9 bpw, abliterated (the "UNCENSORED" bundle), on the TensorFold engine.
#
# Same engine revision as the base profile: this bundle is the same EXL3 2.9 bpw format and shard count as the
# LibertAI pack the engine was measured with, only the weights differ (refusal behaviour removed, MMLU -4.2 pp).
# The branch's BF16 overlay (feat/uncensored-bf16-option + TensorFold PR #8, unmerged) is a different, unqualified
# option; see docs/tensorfold.md.
IMAGE=tensorfold-dsv41:07aa02585f64
TF_REPO=https://github.com/Elevatormusic/TensorFold.git
TF_COMMIT=07aa02585f64
TF_DS_PREFILL_CHUNK=2048

MODEL_VIEW=${MODEL_ROOT:?}/ds41-dealign-1017
DOWNLOAD_DIR=${MODEL_VIEW}.src
CACHE_DIR=${CACHE_ROOT:?}/dealign

SERVED_NAME=DeepSeek-V4.1-Flash-1017-UNCENSORED
SERVED_ALIAS=
PORT=8888
BIND_HOST=127.0.0.1
API_KEY_FILE=
CONTEXT=131072
PARALLEL=4
MTP_DRAFTS=5
SPILL_GIB=64
MEM_FLOOR_GIB=1.5
TEMPERATURE=1.0
TOP_P=1.0
VISION=1
RESTART_POLICY=no
