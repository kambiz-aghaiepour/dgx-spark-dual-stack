# dealignai DeepSeek-V4.1-Flash-1017 EXL3 2.9 bpw, abliterated (the "UNCENSORED" bundle), on the TensorFold engine.
#
# Engine 6c53993: the revision that can load a BF16 matrix where the base revision demands an EXL3 trellis.
# This bundle keeps its attention output matrices (wo_b) in BF16, so the base engine stops on
# KeyError 'layers.10.attn.wo_b.trellis'. The BF16 path is in the recipe branch's engine revision
# (TensorFold PR #8, unmerged); measured speed and quality with it are not established yet.
IMAGE=tensorfold-dsv41:6c53993796ef
TF_REPO=https://github.com/Elevatormusic/TensorFold.git
TF_COMMIT=6c53993796efddcb0a80fafc49fa2d952544eda2
TF_DS_PREFILL_CHUNK=2048

MODEL_VIEW=${MODEL_ROOT:?}/ds41-dealign-1017
DOWNLOAD_DIR=${MODEL_VIEW}.src
CACHE_DIR=${CACHE_ROOT:?}/dealign

SERVED_NAME=DeepSeek-V4.1-Flash-1017-UNCENSORED
SERVED_ALIAS=
# LAN exposure (user's choice): listen on every interface, no API key. Anything on the home
# network can use this engine unauthenticated. Set API_KEY_FILE and BIND_HOST=127.0.0.1 (or
# point clients at an ssh -L tunnel) to close it again.
# 8888 stays the port: `tensorfold serve` takes one --host/--port pair, and 8000 belongs to
# the vLLM stack that takes the pair over when you switch back.
PORT=8888
BIND_HOST=0.0.0.0
API_KEY_FILE=
CONTEXT=131072
PARALLEL=4
MTP_DRAFTS=5
SPILL_GIB=64
MEM_FLOOR_GIB=1.5
TEMPERATURE=1.0
TOP_P=1.0
VISION=1
RESTART_POLICY=no
