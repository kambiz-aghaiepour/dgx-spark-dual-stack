#!/bin/bash
# Readiness gate for the TensorFold (MiaAI) stack: waits until its API answers and the
# worker on the CX7 link is reachable. Used as ExecStartPost and usable by hand.
PORT="${SPARK_TENSORFOLD_PORT:-8000}"
WORKER_IP="${SPARK_TENSORFOLD_WORKER_IP:-192.168.177.12}"
for i in $(seq 1 180); do
  curl -fsS -m 10 "http://localhost:$PORT/v1/models" >/dev/null 2>&1 && \
  ping -c1 -W2 "$WORKER_IP" >/dev/null 2>&1 && {
    echo "TENSORFOLD HEALTHY (attempt $i)"; exit 0; }
  sleep 10
done
echo "TENSORFOLD NOT HEALTHY after 30 min" >&2
exit 1
