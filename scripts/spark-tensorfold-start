#!/bin/bash
# Start the TensorFold stack (MiaAI-Lab DSv4.1 native-Zig engine) for the systemd unit.
# The recipe's start.sh does the work; this wrapper gates on stack.conf and locates it.
set -euo pipefail
CONF="${SPARK_STACK_CONF:-$HOME/.config/spark-vllm/stack.conf}"
STACK=""
[ -f "$CONF" ] && STACK=$(sed -n 's/^STACK=//p' "$CONF" | head -1)
if [ "$STACK" != tensorfold ]; then
  echo "spark-tensorfold-start: stack.conf says '${STACK:-vllm}', not tensorfold - nothing to do"
  exit 0
fi
MIA_DIR="${SPARK_MIA_DIR:-$HOME/mia-dsv41}"
[ -x "$MIA_DIR/start.sh" ] || {
  echo "spark-tensorfold-start: Mia recipe missing at $MIA_DIR (run scripts/setup-mia-recipe.sh)" >&2
  exit 1
}
exec "$MIA_DIR/start.sh"
